# Manual install (on crt-vm), same pattern as crt-vm-hardware-check.service:
#   sed "s/@USER@/$USER/g; s#@PROJECT_DIR@#$HOME/crt#g" \
#     systemd/crt-vm-watchdog.service | sudo tee \
#     /etc/systemd/system/crt-vm-watchdog.service
#   sudo cp systemd/crt-vm-watchdog.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crt-vm-watchdog.timer
[Unit]
Description=crt VM tmux-pipeline heal pass (see bin/crt-vm-watchdog.sh)
After=network.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@PROJECT_DIR@
ExecStart=/usr/bin/env bash @PROJECT_DIR@/bin/crt-vm-watchdog.sh
TimeoutStartSec=60
