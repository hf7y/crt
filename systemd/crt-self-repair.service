# potato-only. Manual install (on potato):
#   sed "s/@USER@/$USER/g; s#@PROJECT_DIR@#$HOME/crt#g" \
#     systemd/crt-self-repair.service | sudo tee \
#     /etc/systemd/system/crt-self-repair.service
#   sudo cp systemd/crt-self-repair.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crt-self-repair.timer
[Unit]
Description=crt potato nightly self-repair pass (see SELF-REPAIR.md)
After=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@PROJECT_DIR@
ExecStart=/usr/bin/env bash @PROJECT_DIR@/bin/crt-self-repair.sh
# An unattended claude -p run that hangs shouldn't block the next
# scheduled tick or run forever unsupervised overnight.
TimeoutStartSec=1800
