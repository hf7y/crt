# NOT installed automatically by install.sh -- see VM-JOBS.md for the
# manual install steps. Reworked 2026-07-20: this used to shell out to an
# unattended `claude -p /vm-hardware-check`, but every check it runs
# (test suite, device presence, exit codes) is mechanical -- no judgment
# call an LLM was actually needed for -- so it's now a plain script,
# bin/crt-vm-hardware-check.sh. Cheaper, deterministic, no agent trust
# surface on a box the household uses daily. If a future check genuinely
# needs interpretation, that's a signal for the interactive tier, not a
# reason to bring the agent back here.
#
# Manual install (on crt-vm):
#   sed "s/@USER@/$USER/g; s#@PROJECT_DIR@#$HOME/crt#g" \
#     systemd/crt-vm-hardware-check.service | sudo tee \
#     /etc/systemd/system/crt-vm-hardware-check.service
#   sudo cp systemd/crt-vm-hardware-check.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crt-vm-hardware-check.timer
[Unit]
Description=crt VM-resident hardware-verification pass (see VM-JOBS.md)
After=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@PROJECT_DIR@
ExecStart=/usr/bin/env bash @PROJECT_DIR@/bin/crt-vm-hardware-check.sh
# A hardware pass that hangs (e.g. on a stuck audio device) shouldn't run
# forever and block the next scheduled tick -- kill it and let the report
# note the timeout rather than wedging silently.
TimeoutStartSec=600
