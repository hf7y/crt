# NOT installed automatically by install.sh (2026-07-19) -- this runs an
# unattended `claude -p` with real hardware access on crt-vm, which is a
# meaningfully bigger trust step than anything install.sh does today.
# See VM-JOBS.md for the full design and manual install steps. Deliberately
# not silently wired in on the next `install.sh` run of an existing
# checkout -- review this file and VM-JOBS.md's install steps first.
#
# Manual install (on crt-vm):
#   sed "s/@USER@/$USER/g; s#@PROJECT_DIR@#$HOME/crt#g" \
#     systemd/crt-vm-hardware-check.service | sudo tee \
#     /etc/systemd/system/crt-vm-hardware-check.service
#   sudo cp systemd/crt-vm-hardware-check.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crt-vm-hardware-check.timer
[Unit]
Description=crt VM-resident hardware-verification pass (see VM-JOBS.md)
After=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@PROJECT_DIR@
# acceptEdits (not bypassPermissions): this job should only ever read
# hardware state and write reports/commits -- if it ever wants to do
# something bigger than a file edit, that's a signal to stop and ask,
# not a permission mode to relax further.
ExecStart=/usr/bin/env claude -p /vm-hardware-check --permission-mode acceptEdits
# A hardware pass that hangs (e.g. on a stuck audio device) shouldn't run
# forever and block the next scheduled tick -- kill it and let the report
# note the timeout rather than wedging silently.
TimeoutStartSec=1800
