# Manual install (on crt-vm), same pattern as crt-vm-watchdog.service:
#   sed "s/@USER@/$USER/g; s#@PROJECT_DIR@#$HOME/crt#g" \
#     systemd/crt-scanner-feed.service | sudo tee \
#     /etc/systemd/system/crt-scanner-feed.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crt-scanner-feed.service
#
# Listens on 0.0.0.0:8993 for scans forwarded from dexter's USB barcode
# scanner (see SCANNER.md, bin/dexter-scanner-forward.ps1) and delivers
# them into the tmux Claude Code pane, same as the STT feed. Started
# ad hoc with nohup on 2026-07-21 for first live test -- installing this
# unit makes it survive a VM reboot.
[Unit]
Description=crt scanner-forward listener (receives dexter barcode scans)
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@PROJECT_DIR@
ExecStart=/usr/bin/env python3 @PROJECT_DIR@/bin/crt-scanner-feed.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
