# potato-only (see SELF-REPAIR.md). NOT installed by install.sh -- that
# script's shared default is acceptEdits, not potato's escalated
# bypassPermissions (crt-vm, which used that shared default, is retired --
# crt#162).
# Offset from crt-vm-hardware-check's 06:30 slot and the mandark scheduler's
# own windows so reports don't all land at once.
[Unit]
Description=Run crt's nightly self-repair pass on potato

[Timer]
OnCalendar=*-*-* 04:15:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
