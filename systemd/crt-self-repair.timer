# potato-only (see SELF-REPAIR.md). NOT installed by install.sh -- that
# script's shared default is acceptEdits, not potato's escalated
# bypassPermissions (crt-vm, which used that shared default, is retired --
# crt#162).
# Offset was picked to avoid crt-vm-hardware-check's 06:30 slot, a job that
# ran on crt-vm itself and is gone with it (retired, crt#162); kept at 04:15
# regardless since it also stays clear of the mandark scheduler's own windows.
[Unit]
Description=Run crt's nightly self-repair pass on potato

[Timer]
OnCalendar=*-*-* 04:15:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
