# Example ~/.crt/console.conf -- copy to ~/.crt/console.conf and edit.
#
# This is the console's identity: what it answers to, where it makes
# noise, what hardware and network services it uses. Read by
# bin/crt-conf.sh, which crt-console.sh and crt-stt-supervisor.sh both
# source. See crt-conf.sh's header for why this file exists rather than
# a pile of exports in ~/.bash_profile.
#
# Use the ${VAR:-value} form throughout, NOT a bare assignment: an
# explicit env var (a one-off test, a value crt-console.sh passes down)
# must still win over the file. A bare `CRT_WAKE_WORD=potato` here would
# silently overwrite the override someone typed on the command line.

# The name the console answers to. crt-stt-solo.py's built-in default is
# "claude" -- wrong for this box, and wrong in the quiet way: the mic
# keeps working and every request is just dropped as "no wake word".
export CRT_WAKE_WORD="${CRT_WAKE_WORD:-potato}"

# Where earcons play. "tv" = room-wide speakers, "handset" = the phone
# earpiece only. crt-stt-solo.py defaults to "handset", which on a
# console nobody is holding is indistinguishable from no earcons at all.
export CRT_EARCON_DEVICE="${CRT_EARCON_DEVICE:-tv}"

# Mic. plughw:1,0 is the KT USB Audio capture device on potato.
# crt-lib-audio-device.sh can resolve by NAME instead if this is unset.
export CRT_AUDIO_DEV="${CRT_AUDIO_DEV:-plughw:1,0}"

# Transcription. Host is deliberately spelled out here and nowhere else,
# because "which machine holds the ears" is a thing that moves. It moved:
# dexter's whisper container answers the tailnet now (#133): 11s of audio in
# 0.87s, against 14.7s on a Pi 3B+'s own tiny.en. Empty transcribes
# on-device instead -- slow, and where an unreachable server lands anyway.
export CRT_WHISPER_SERVER="${CRT_WHISPER_SERVER:-http://100.107.253.56:8090/inference}"

# Wake-arm judging (see WAKE-TUNING-STATE.md). Opt-in; default off.
export CRT_WAKE_ARM_ENABLED="${CRT_WAKE_ARM_ENABLED:-1}"

# Idle-lean layout: hold no Claude brain on potato while idle (it was
# ~37% of this 1GB Pi's RAM). Escalations route to the brain host.
export CRT_NO_IDLE_CLAUDE="${CRT_NO_IDLE_CLAUDE:-1}"

# Claude Code flags for any brain started ON potato (the fallback, not
# the dexter brain). Zero permission prompts -- hands-free, and this
# console does its own trusted work.
export CRT_CLAUDE_ARGS="${CRT_CLAUDE_ARGS:---permission-mode bypassPermissions}"

# Brain routing (CRT_CLAUDE_SSH_HOST / CRT_CLAUDE_REMOTE_PORT) is NOT
# here on purpose -- it lives in ~/.crt/brain.conf, which crt-conf.sh
# reads after this file so it wins. That is the one Zach flips at
# runtime.
