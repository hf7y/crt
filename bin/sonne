    exec "$LEGACY_ROOT/bin/crt-earcon.sh" "$@" ;;
  crt-idle-bait)
    [ -x "$LEGACY_ROOT/bin/crt-idle-bait.sh" ] || verb_gap 'crt-idle-bait: bin/crt-idle-bait.sh is not executable or not present'
