    [ -x "$LEGACY_ROOT/bin/crt-levels.sh" ] || verb_gap 'crt-levels: bin/crt-levels.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-levels.sh" "$@" ;;
  crt-lib-audio-device)
    [ -x "$LEGACY_ROOT/bin/crt-lib-audio-device.sh" ] || verb_gap 'crt-lib-audio-device: bin/crt-lib-audio-device.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-lib-audio-device.sh" "$@" ;;
  crt-mandark-serve)
    [ -x "$LEGACY_ROOT/bin/crt-mandark-serve.sh" ] || verb_gap 'crt-mandark-serve: bin/crt-mandark-serve.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-mandark-serve.sh" "$@" ;;
  crt-mandark)
    [ -x "$LEGACY_ROOT/bin/crt-mandark.sh" ] || verb_gap 'crt-mandark: bin/crt-mandark.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-mandark.sh" "$@" ;;
  crt-monologue)
    [ -x "$LEGACY_ROOT/bin/crt-monologue.sh" ] || verb_gap 'crt-monologue: bin/crt-monologue.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-monologue.sh" "$@" ;;
  crt-print)
    [ -x "$LEGACY_ROOT/bin/crt-print.sh" ] || verb_gap 'crt-print: bin/crt-print.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-print.sh" "$@" ;;
  crt-report)
    [ -x "$LEGACY_ROOT/bin/crt-report.sh" ] || verb_gap 'crt-report: bin/crt-report.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-report.sh" "$@" ;;
  crt-ring)
    [ -x "$LEGACY_ROOT/bin/crt-ring.sh" ] || verb_gap 'crt-ring: bin/crt-ring.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-ring.sh" "$@" ;;
