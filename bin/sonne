#!/usr/bin/env bash
# sonne -- ring the handset: voice front end for a terminal
#
# A plain shell utility. It costs nothing to run and reaches no paid service
# except where a subcommand explicitly declares a summon.
#
# The subcommand table below was DISCOVERED from tooling that actually exists
# in this tree, not invented. A subcommand backed by a script execs it. One
# the contract names but has nothing behind it reports GAP (exit 4) rather
# than pretending, because an exit-0 no-op is the worst failure available.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=sonne
VERB_SUMMARY="ring the handset: voice front end for a terminal"
VERB_USAGE="sonne <subcommand> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

# Where the legacy implementation lives, for subcommands that exec it. Read
# from ONE place; never retyped per subcommand.
LEGACY_ROOT="${SONNE_LEGACY_ROOT:-/home/zach/Documents/Projects/crt}"

verb_subcommands() {
  printf '%s\n' \
    'crt-announce                 run bin/crt-announce.sh' \
    'crt-attach-ssh-bridge        run bin/crt-attach-ssh-bridge.sh' \
    'crt-audio-doctor             run bin/crt-audio-doctor.sh' \
    'crt-bell-test                run bin/crt-bell-test.sh' \
    'crt-bibquotes-sync           run bin/crt-bibquotes-sync.sh' \
    'crt-brain-session            run bin/crt-brain-session.sh' \
    'crt-capture-watchdog         run bin/crt-capture-watchdog.sh' \
    'crt-conf                     run bin/crt-conf.sh' \
    'crt-console                  run bin/crt-console.sh' \
    'crt-console-solo             run bin/crt-console-solo.sh' \
    'crt-earcon                   run bin/crt-earcon.sh' \
    'crt-idle-bait                run bin/crt-idle-bait.sh' \
    'crt-idle-teaser              run bin/crt-idle-teaser.sh' \
    'crt-levels                   run bin/crt-levels.sh' \
    'crt-lib-audio-device         run bin/crt-lib-audio-device.sh' \
    'crt-mandark-serve            run bin/crt-mandark-serve.sh' \
    'crt-mandark                  run bin/crt-mandark.sh' \
    'crt-monologue                run bin/crt-monologue.sh' \
    'crt-print                    run bin/crt-print.sh' \
    'crt-report                   run bin/crt-report.sh' \
    'crt-ring                     run bin/crt-ring.sh' \
    'crt-self-repair              run bin/crt-self-repair.sh' \
    'crt-senechal-guard           run bin/crt-senechal-guard.sh' \
    'crt-session-audit            run bin/crt-session-audit.sh' \
    'crt-sideband-set             run bin/crt-sideband-set.sh' \
    'crt-sideband                 run bin/crt-sideband.sh' \
    'crt-stt                      run bin/crt-stt.sh' \
    'crt-stt-speakback            run bin/crt-stt-speakback.sh' \
    'crt-stt-stream-view          run bin/crt-stt-stream-view.sh' \
    'crt-stt-supervisor           run bin/crt-stt-supervisor.sh' \
    'crt-think                    run bin/crt-think.sh' \
    'crt-voice-calibration        run bin/crt-voice-calibration.sh' \
    'hookswitch-listen            run bin/hookswitch-listen.sh' \
    'setup-mandark-whisper-persistence run bin/setup-mandark-whisper-persistence.sh' \
    'setup-potato-audio-sharing   run bin/setup-potato-audio-sharing.sh' \
    'stt-feed                     run bin/stt-feed.sh' \
    'add-installdata-partition    run cad/add-installdata-partition.sh' \
    'copy-candidate-preseeds      run cad/copy-candidate-preseeds.sh' \
    'copy-minimal-test            run cad/copy-minimal-test.sh' \
    'export_stl                   run cad/export_stl.sh' \
    'finish-pi-usb                run cad/finish-pi-usb.sh' \
    'flash-bootia32               run cad/flash-bootia32.sh' \
    'flash-pi-usb                 run cad/flash-pi-usb.sh' \
    'format-and-copy-installdata  run cad/format-and-copy-installdata.sh' \
    'sideload-us-keyboard         run cad/sideload-us-keyboard.sh' \
    'sideload-wifi                run cad/sideload-wifi.sh' \
    'update-diag-initrd           run cad/update-diag-initrd.sh' \
    'install                      run install.sh' \
    ''
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

case "$cmd" in
  ''|list)
    printf '%s -- %s\n\n' "$VERB_NAME" "$VERB_SUMMARY"
    printf 'subcommands (discovered from real tooling):\n'
    verb_subcommands | sed '/^$/d' | sed 's/^/  /'
    printf '\n(`%s --help` for flags, `man %s` for the contract)\n' "$VERB_NAME" "$VERB_NAME"
    ;;
  help|--help|-h) verb_usage ;;
  crt-announce)
    [ -x "$LEGACY_ROOT/bin/crt-announce.sh" ] || verb_gap 'crt-announce: bin/crt-announce.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-announce.sh" "$@" ;;
  crt-attach-ssh-bridge)
    [ -x "$LEGACY_ROOT/bin/crt-attach-ssh-bridge.sh" ] || verb_gap 'crt-attach-ssh-bridge: bin/crt-attach-ssh-bridge.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-attach-ssh-bridge.sh" "$@" ;;
  crt-audio-doctor)
    [ -x "$LEGACY_ROOT/bin/crt-audio-doctor.sh" ] || verb_gap 'crt-audio-doctor: bin/crt-audio-doctor.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-audio-doctor.sh" "$@" ;;
  crt-bell-test)
    [ -x "$LEGACY_ROOT/bin/crt-bell-test.sh" ] || verb_gap 'crt-bell-test: bin/crt-bell-test.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-bell-test.sh" "$@" ;;
  crt-bibquotes-sync)
    [ -x "$LEGACY_ROOT/bin/crt-bibquotes-sync.sh" ] || verb_gap 'crt-bibquotes-sync: bin/crt-bibquotes-sync.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-bibquotes-sync.sh" "$@" ;;
  crt-brain-session)
    [ -x "$LEGACY_ROOT/bin/crt-brain-session.sh" ] || verb_gap 'crt-brain-session: bin/crt-brain-session.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-brain-session.sh" "$@" ;;
  crt-capture-watchdog)
    [ -x "$LEGACY_ROOT/bin/crt-capture-watchdog.sh" ] || verb_gap 'crt-capture-watchdog: bin/crt-capture-watchdog.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-capture-watchdog.sh" "$@" ;;
  crt-conf)
    [ -x "$LEGACY_ROOT/bin/crt-conf.sh" ] || verb_gap 'crt-conf: bin/crt-conf.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-conf.sh" "$@" ;;
  crt-console)
    [ -x "$LEGACY_ROOT/bin/crt-console.sh" ] || verb_gap 'crt-console: bin/crt-console.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-console.sh" "$@" ;;
  crt-console-solo)
    [ -x "$LEGACY_ROOT/bin/crt-console-solo.sh" ] || verb_gap 'crt-console-solo: bin/crt-console-solo.sh is not executable or not present'
