    exec "$LEGACY_ROOT/bin/crt-think.sh" "$@" ;;
  crt-voice-calibration)
    [ -x "$LEGACY_ROOT/bin/crt-voice-calibration.sh" ] || verb_gap 'crt-voice-calibration: bin/crt-voice-calibration.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/crt-voice-calibration.sh" "$@" ;;
  hookswitch-listen)
    [ -x "$LEGACY_ROOT/bin/hookswitch-listen.sh" ] || verb_gap 'hookswitch-listen: bin/hookswitch-listen.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/hookswitch-listen.sh" "$@" ;;
  setup-mandark-whisper-persistence)
    [ -x "$LEGACY_ROOT/bin/setup-mandark-whisper-persistence.sh" ] || verb_gap 'setup-mandark-whisper-persistence: bin/setup-mandark-whisper-persistence.sh is not executable or not present'
